# Example env values - DO NOT commit real secrets
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growth_db?schema=public
# Optional but strongly recommended for local tests and parallel worktrees.
# Create/apply migrations to this database before running `pnpm test`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growth_test?schema=public
PORT=3000
NODE_ENV=development
# Bind address: a literal IPv4/IPv6 address, never a hostname.
# Development/test default is 127.0.0.1. Production has no default: set HOST
# explicitly or startup fails (fail-closed). PORT=0 is accepted only in test.
# HOST=127.0.0.1
# A non-loopback bind (0.0.0.0, ::, or another interface address) additionally
# requires this explicit permission flag; authentication requirements do not
# change because of it.
ALLOW_EXTERNAL_BIND=false
# Trusted reverse-proxy allowlist: comma separated IP/CIDR entries.
# Empty (default) trusts no proxy, so X-Forwarded-* headers never define the
# client identity. Hostnames, empty entries and world routes (0.0.0.0/0, ::/0)
# are rejected by the exposure policy.
# TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated allowlist of origins allowed to call the API cross-origin.
# Leave empty to reject all cross-origin requests.
CORS_ORIGINS=http://localhost:5173
# PR-D5 connection budget (SYS-12). required = API_INSTANCES x (DB_POOL_MAX + 1)
# while worker and MCP are inactive, and it must fit GROWTH_DB_CONNECTION_BUDGET.
# Development/test fall back to the values below; production must state all three
# explicitly (startup fails closed otherwise). The live host capacity stays
# unverified until `SHOW max_connections` is measured there.
# API_INSTANCES=1
# DB_POOL_MAX=5
# GROWTH_DB_CONNECTION_BUDGET=20
# Optional pool/timeout overrides (milliseconds). DB_STATEMENT_TIMEOUT_MS must stay
# below DB_QUERY_TIMEOUT_MS so PostgreSQL cancels a query before the client gives
# up, and readiness keeps its own reviewed budget (see lib/db-pools.ts).
# DB_POOL_CONNECTION_TIMEOUT_MS=2000
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_QUERY_TIMEOUT_MS=6000
# DB_TRANSACTION_MAX_WAIT_MS=2000
# DB_TRANSACTION_TIMEOUT_MS=5000
# Optional in development/test. Required for production business routes.
# Use a password-manager generated value of at least 32 characters; never commit it.
# An empty value counts as unset: development/test starts without a key, while
# production still refuses to start.
# GROWTH_INTERNAL_API_KEY=

# Phase 5 email provider safety gate. Provider execution remains disabled unless
# both values below are explicitly changed and valid provider credentials exist.
EMAIL_PROVIDER_MODE=DISABLED
OUTREACH_TEST_DISPATCH_ENABLED=false
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_FROM_ADDRESS=
