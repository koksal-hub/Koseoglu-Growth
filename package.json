{
  "name": "koseoglu-growth",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@prisma/client": "^7.0.0",
    "@types/node": "^20.8.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^2.8.8",
    "prisma": "^7.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "lint": "pnpm -w run lint:all",
    "lint:all": "eslint \"**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "pnpm -w run typecheck:all",
    "typecheck:all": "pnpm run typecheck:api && pnpm run typecheck:web",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run build:all",
    "build:all": "pnpm --filter \"./apps/*\" run build"
  }
}