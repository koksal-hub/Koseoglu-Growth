# API image — build context must be the repository root:
#   docker compose -f docker/docker-compose.yml build
FROM node:24-bookworm-slim

# openssl is required by Prisma's engines at runtime
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11.21.0

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma.config.ts tsconfig.base.json ./
COPY prisma ./prisma
COPY apps ./apps

# prisma.config.ts requires DATABASE_URL to load; the postinstall
# `prisma generate` only reads the schema, so a placeholder is enough at
# build time. The real DATABASE_URL is injected at runtime (docker-compose).
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" pnpm install --frozen-lockfile

RUN pnpm --filter @growth/api run build

CMD ["node", "apps/api/dist/index.js"]
