generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================================================================
// PHASE 1 — DATA FOUNDATION
// Growth-only models. Never merge with MYLojistik data (ADR-001).
// ================================================================

enum CompanyStatus {
  ACTIVE
  ARCHIVED
  MERGED
}

enum SourceChannel {
  WEBSITE
  GOOGLE
  LINKEDIN
  REFERRAL
  COLD_RESEARCH
  EVENT
  OTHER
}

enum ContactVerificationStatus {
  UNVERIFIED
  VERIFIED
  INVALID
}

enum LeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum ActivityType {
  EMAIL_DRAFT
  EMAIL_SENT
  EMAIL_REPLY
  PHONE_CALL
  NOTE
  MEETING
  QUOTE_REQUEST
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

/// Durable internal work item state. Jobs are deliberately limited to
/// deterministic in-process handlers in Phase 6; they do not authorize
/// external email, social-media, or customer operations.
enum JobStatus {
  QUEUED
  RUNNING
  RETRYABLE_FAILED
  SUCCEEDED
  DEAD_LETTER
}

enum SocialPlatform {
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  X
  THREADS
  TIKTOK
  YOUTUBE
  GOOGLE_BUSINESS
  PINTEREST
}

enum SocialConnectionStatus {
  DISCONNECTED
  CONNECTED
  REAUTH_REQUIRED
  REVOKED
}

enum SocialMasterContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum SocialContentVariantStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum EventType {
  COMPANY_DISCOVERED
  COMPANY_UPDATED
  COMPANY_VERIFIED
  CONTACT_DISCOVERED
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  OPPORTUNITY_CREATED
  CUSTOMER_WON
  CUSTOMER_LOST
  RESEARCH_MISSION_CREATED
  RESEARCH_CANDIDATE_PROPOSED
  RESEARCH_CANDIDATE_ACCEPTED
  RESEARCH_CANDIDATE_REJECTED
  RESEARCH_CANDIDATE_NEEDS_EVIDENCE
  RESEARCH_EVIDENCE_ADDED
  CONTACT_POINT_COLLECTED
  CONTACT_POINT_VERIFIED
  COMMUNICATION_PERMISSION_RECORDED
  COMMUNICATION_SUPPRESSED
  COMPANY_RANKING_RECORDED
  OUTREACH_DRAFT_CREATED
  OUTREACH_DRAFT_REVISED
  OUTREACH_REVIEW_REQUESTED
  OUTREACH_APPROVAL_RECORDED
  OUTREACH_DRAFT_EXPIRED
  SEND_ATTEMPT_PREPARED
  TEST_PROVIDER_DISPATCH_STARTED
  TEST_PROVIDER_ACCEPTED
  TEST_PROVIDER_OUTCOME_UNKNOWN
  TEST_PROVIDER_FAILED
  DELIVERY_EVENT_RECORDED
  REPLY_RECEIPT_RECORDED
}

enum ResearchMissionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ResearchCandidateStatus {
  PROPOSED
  NEEDS_MORE_EVIDENCE
  ACCEPTED
  REJECTED
}

enum EvidenceFreshnessStatus {
  CURRENT
  STALE
  UNKNOWN
}

enum ContactPointType {
  EMAIL
  PHONE
}

enum ContactPointClassification {
  COMPANY_GENERAL
  PERSON_WORK
  PERSONAL
  UNKNOWN
}

enum ContactPointVerificationStatus {
  UNVERIFIED
  VERIFIED
  INVALID
  STALE
}

enum PrivacyNoticeStatus {
  NOT_REQUIRED
  PENDING
  PROVIDED
  EXEMPTION_RECORDED
}

enum DataProcessingBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  PUBLIC_INTEREST
  VITAL_INTEREST
  PUBLICIZED_BY_DATA_SUBJECT
  LEGAL_CLAIM
  NOT_PERSONAL_DATA
  UNKNOWN
}

enum CommunicationChannel {
  EMAIL
  PHONE
  SMS
  WHATSAPP
}

enum CommunicationPurpose {
  SALES_OUTREACH
  MARKETING
  CUSTOMER_SERVICE
}

enum CommunicationPermissionStatus {
  ALLOWED
  DENIED
  OPTED_OUT
  SUPPRESSED
}

enum CommunicationRule {
  EXPLICIT_CONSENT
  EXISTING_CUSTOMER
  B2B_RECIPIENT_EXCEPTION
  SOFT_OPT_IN
  OTHER_REVIEWED
  UNKNOWN
}

enum RecipientCategory {
  LEGAL_ENTITY
  TRADER_OR_CRAFTSMAN
  CONSUMER
  UNKNOWN
}

enum DailyActionType {
  VERIFY_COMPANY
  COLLECT_EVIDENCE
  VERIFY_CONTACT_POINT
  REVIEW_COMMUNICATION_PERMISSION
  HONOR_SUPPRESSION
  READY_FOR_HUMAN_OUTREACH_REVIEW
}

enum OutreachDraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum OutreachApprovalDecision {
  APPROVED
  REJECTED
}

enum EmailProvider {
  RESEND
}

enum SendRecipientMode {
  TEST_SIMULATION
}

enum SandboxDeliveryScenario {
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
}

enum SendAttemptStatus {
  PREPARED
  DISPATCHING
  ACCEPTED
  UNKNOWN
  FAILED
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
}

enum DeliveryEventType {
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
  DELIVERY_DELAYED
}

enum WebhookReceiptOutcome {
  PROCESSED
  IGNORED
}

enum ReplyClassification {
  UNCLASSIFIED
}

/// A B2B company Growth has discovered, researched, or sold to.
/// `domain`, `taxNumber` and `normalizedName` are expected to be normalized
/// (see apps/api/src/lib/entity-resolution.ts) before being written here.
model Company {
  id             String         @id @default(cuid())
  name           String
  normalizedName String
  taxNumber      String?
  domain         String?
  phone          String?
  emailDomain    String?
  country        String?
  city           String?
  address        String?
  sector         String?
  activity       String?
  website        String?
  status         CompanyStatus  @default(ACTIVE)
  /// 0..1 — how confident Growth is that this record is accurate. Manually
  /// entered/curated companies default to 1; Phase 2 discovery will write
  /// lower values pending verification (see ADR-008 Confidence Gate).
  /// Range is enforced in the DB via CHECK constraint
  /// "Company_confidence_range" (additive migration, not expressible here).
  confidence     Float          @default(1)
  sourceChannel  SourceChannel?
  sourceDetail   String?

  /// Set when this company was identified as a duplicate and merged into
  /// another canonical Company record (see entity-resolution.ts).
  mergedIntoId String?
  mergedInto   Company?  @relation("CompanyMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Company[] @relation("CompanyMerge")

  contacts                  Contact[]
  contactPoints             ContactPoint[]
  leads                     Lead[]
  opportunities             Opportunity[]
  evidences                 Evidence[]
  rankingReceipts           CompanyRankingReceipt[]
  outreachDrafts            OutreachDraft[]
  researchCandidates        ResearchCandidate[]     @relation("ResearchCandidateAcceptedCompany")
  matchedResearchCandidates ResearchCandidate[]     @relation("ResearchCandidateMatchedCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxNumber])
  @@unique([domain])
  @@index([normalizedName])
  @@index([emailDomain])
  @@index([status])
}

/// A bounded, human-owned research assignment. The first version accepts
/// manual/fixture input only; crawlers and LLMs are deliberately out of scope.
model ResearchMission {
  id             String                @id @default(cuid())
  name           String
  scope          String
  country        String?
  region         String?
  sector         String?
  route          String?
  status         ResearchMissionStatus @default(ACTIVE)
  budgetLimit    Decimal?              @db.Decimal(14, 2)
  budgetCurrency String                @default("TRY")
  owner          String
  startedAt      DateTime              @default(now())
  completedAt    DateTime?

  candidates ResearchCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([owner])
  @@index([createdAt])
}

/// A proposed company inside a ResearchMission. Proposed fields remain as a
/// source snapshot; `matchedCompanyId` records deterministic resolution as a
/// proposal, while `companyId` is set only after an accepted human decision.
model ResearchCandidate {
  id               String                  @id @default(cuid())
  missionId        String
  mission          ResearchMission         @relation(fields: [missionId], references: [id])
  companyId        String?
  company          Company?                @relation("ResearchCandidateAcceptedCompany", fields: [companyId], references: [id])
  matchedCompanyId String?
  matchedCompany   Company?                @relation("ResearchCandidateMatchedCompany", fields: [matchedCompanyId], references: [id])
  proposedName     String
  taxNumber        String?
  domain           String?
  phone            String?
  emailDomain      String?
  country          String?
  city             String?
  address          String?
  sector           String?
  activity         String?
  website          String?
  reason           String
  status           ResearchCandidateStatus @default(PROPOSED)
  /// 0..1, also enforced by the DB constraint
  /// "ResearchCandidate_confidence_range".
  confidence       Float
  /// Deterministic entity-resolution receipt. A match proposes a link; the
  /// human decision still controls whether the candidate is accepted.
  matchedBy        String?
  matchConfidence  Float?
  decisionReason   String?
  decidedBy        String?
  decidedAt        DateTime?

  evidences Evidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([missionId])
  @@index([companyId])
  @@index([matchedCompanyId])
  @@index([status])
}

/// A person at a Company. Not a MYLojistik operational contact.
model Contact {
  id                 String                    @id @default(cuid())
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id])
  fullName           String
  jobTitle           String?
  /// Expected lowercased/trimmed before persisting (see entity-resolution.ts).
  email              String?
  phone              String?
  verificationStatus ContactVerificationStatus @default(UNVERIFIED)
  sourceChannel      SourceChannel?
  sourceDetail       String?

  leads         Lead[]
  activities    Activity[]
  followUps     FollowUp[]
  contactPoints ContactPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NOTE: email is nullable, and in Postgres NULLs are distinct in unique
  /// indexes — so multiple Contacts with a NULL email in the SAME company
  /// are allowed. This is intentional: people whose email we haven't
  /// discovered yet must still be storable, and NULL means "unknown", not a
  /// value that can collide. If this ever needs to be restricted, use a
  /// partial unique index instead of tightening this constraint.
  @@unique([companyId, email])
  @@unique([id, companyId])
  @@index([companyId])
}

/// A sourced communication address. A public email/phone is discovery data,
/// not permission to contact. Values are normalized before persistence.
model ContactPoint {
  id                  String                         @id @default(cuid())
  companyId           String
  company             Company                        @relation(fields: [companyId], references: [id])
  contactId           String?
  contact             Contact?                       @relation(fields: [contactId, companyId], references: [id, companyId])
  type                ContactPointType
  classification      ContactPointClassification
  normalizedValue     String
  countryCode         String
  sourceUrl           String
  sourceName          String?
  sourceIsPublic      Boolean
  collectedAt         DateTime
  observedAt          DateTime?
  verificationStatus  ContactPointVerificationStatus @default(UNVERIFIED)
  verifiedAt          DateTime?
  verifiedBy          String?
  verificationReason  String?
  confidence          Float
  collectionPurpose   String
  dataProcessingBasis DataProcessingBasis
  noticeStatus        PrivacyNoticeStatus
  noticeProvidedAt    DateTime?
  retentionUntil      DateTime?
  deletedAt           DateTime?

  permissions    CommunicationPermission[]
  outreachDrafts OutreachDraft[]
  sendAttempts   SendAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type, normalizedValue])
  @@index([companyId])
  @@index([contactId])
  @@index([verificationStatus])
  @@index([retentionUntil])
}

/// Append-only human/legal review receipt. An ALLOWED receipt is necessary
/// but not sufficient: the dry-run gate also checks verification, retention,
/// classification, channel compatibility, and global suppression.
model CommunicationPermission {
  id                  String                        @id @default(cuid())
  contactPointId      String
  contactPoint        ContactPoint                  @relation(fields: [contactPointId], references: [id])
  channel             CommunicationChannel
  purpose             CommunicationPurpose
  jurisdictionCountry String
  status              CommunicationPermissionStatus
  dataProcessingBasis DataProcessingBasis
  communicationRule   CommunicationRule
  recipientCategory   RecipientCategory
  consentReference    String?
  evidenceUrl         String?
  policyVersion       String
  checkedAt           DateTime
  expiresAt           DateTime?
  reviewedBy          String
  reason              String
  createdAt           DateTime                      @default(now())

  outreachApprovals OutreachApproval[]
  sendAttempts      SendAttempt[]

  @@unique([id, contactPointId], map: "CommunicationPermission_contact_receipt_key")
  @@index([contactPointId, channel, purpose, jurisdictionCountry], map: "CommunicationPermission_contactPointId_channel_purpose_jurisdic")
  @@index([status])
  @@index([checkedAt])
}

/// Global, append-only block keyed by a pseudonymous recipient hash. The hash
/// is deterministic for matching, so it is pseudonymous rather than anonymous.
model SuppressionEntry {
  id            String               @id @default(cuid())
  channel       CommunicationChannel
  recipientHash String
  reason        String
  source        String
  recordedBy    String
  createdAt     DateTime             @default(now())

  @@unique([channel, recipientHash])
  @@index([createdAt])
}

/// Immutable, deterministic scoring receipt. Component scores are integers so
/// the database can enforce both their bounds and the exact total.
model CompanyRankingReceipt {
  id                     String          @id @default(cuid())
  companyId              String
  company                Company         @relation(fields: [companyId], references: [id])
  algorithmVersion       String
  policyVersion          String
  inputHash              String
  context                Json
  evidenceReceipt        Json
  contactReceipt         Json
  icpFitScore            Int
  companyConfidenceScore Int
  evidenceScore          Int
  contactScore           Int
  permissionScore        Int
  totalScore             Int
  reasonCodes            Json
  nextAction             DailyActionType
  evaluatedAt            DateTime
  createdBy              String
  createdAt              DateTime        @default(now())

  outreachDrafts OutreachDraft[]

  @@unique([companyId, algorithmVersion, inputHash])
  @@index([policyVersion, evaluatedAt])
  @@index([totalScore])
  @@index([nextAction])
}

/// Human-authored email content that is deliberately separate from delivery.
/// Recipient data is snapshotted pseudonymously; the raw normalized value stays
/// in ContactPoint and is never copied into approval/event receipts.
model OutreachDraft {
  id                    String                @id @default(cuid())
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id])
  contactPointId        String
  contactPoint          ContactPoint          @relation(fields: [contactPointId], references: [id])
  rankingReceiptId      String
  rankingReceipt        CompanyRankingReceipt @relation(fields: [rankingReceiptId], references: [id])
  channel               CommunicationChannel
  purpose               CommunicationPurpose
  jurisdictionCountry   String
  policyVersion         String
  templateKey           String
  templateVersion       String
  generationMethod      String                @default("HUMAN_AUTHORED")
  author                String
  recipientSnapshot     Json
  status                OutreachDraftStatus   @default(DRAFT)
  currentRevisionNumber Int                   @default(1)
  expiresAt             DateTime
  submittedAt           DateTime?
  submittedBy           String?

  revisions    OutreachDraftRevision[]
  approval     OutreachApproval?
  sendAttempts SendAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, contactPointId])
  @@index([companyId, status])
  @@index([contactPointId])
  @@index([rankingReceiptId])
  @@index([expiresAt])
}

/// Append-only content history. Editing a draft creates a new row and content
/// hash; no route updates or deletes an existing revision.
model OutreachDraftRevision {
  id             String        @id @default(cuid())
  draftId        String
  draft          OutreachDraft @relation(fields: [draftId], references: [id])
  revisionNumber Int
  subject        String
  body           String
  contentHash    String
  editedBy       String
  editReason     String
  createdAt      DateTime      @default(now())

  approval     OutreachApproval?
  sendAttempts SendAttempt[]

  @@unique([draftId, revisionNumber])
  @@unique([id, draftId])
  @@unique([id, draftId, contentHash])
  @@index([contentHash])
}

/// Append-only independent human decision. An APPROVED receipt is still not a
/// send instruction: no provider, message id, or delivery state exists here.
model OutreachApproval {
  id             String                   @id @default(cuid())
  draftId        String                   @unique
  draft          OutreachDraft            @relation(fields: [draftId], references: [id])
  revisionId     String                   @unique
  revision       OutreachDraftRevision    @relation(fields: [revisionId], references: [id])
  decision       OutreachApprovalDecision
  decisionReason String
  reviewedBy     String
  policyVersion  String
  permissionId   String?
  permission     CommunicationPermission? @relation(fields: [permissionId], references: [id], onDelete: Restrict, map: "OutreachApproval_permissionId_fkey")
  gateReceipt    Json
  contentHash    String
  decidedAt      DateTime
  createdAt      DateTime                 @default(now())

  sendAttempts SendAttempt[]

  @@unique([id, draftId, revisionId, contentHash], map: "OutreachApproval_send_receipt_key")
  @@unique([id, draftId, revisionId, contentHash, permissionId], map: "OutreachApproval_send_permission_receipt_key")
  @@index([decision, decidedAt])
  @@index([permissionId])
}

/// Mutable delivery aggregate for the provider test sandbox only. The approved
/// recipient and the provider recipient are stored as separate pseudonymous
/// hashes; no raw address or customer-send mode exists in this phase.
model SendAttempt {
  id                       String                  @id @default(cuid())
  draftId                  String
  draft                    OutreachDraft           @relation(fields: [draftId, contactPointId], references: [id, contactPointId], map: "SendAttempt_draft_contact_fkey")
  approvalId               String
  approval                 OutreachApproval        @relation(fields: [approvalId, draftId, revisionId, contentHash, permissionId], references: [id, draftId, revisionId, contentHash, permissionId], map: "SendAttempt_approval_permission_fkey")
  revisionId               String
  revision                 OutreachDraftRevision   @relation(fields: [revisionId, draftId, contentHash], references: [id, draftId, contentHash], map: "SendAttempt_revision_receipt_fkey")
  contactPointId           String
  contactPoint             ContactPoint            @relation(fields: [contactPointId], references: [id])
  permissionId             String
  permission               CommunicationPermission @relation(fields: [permissionId, contactPointId], references: [id, contactPointId], map: "SendAttempt_contact_permission_fkey")
  provider                 EmailProvider           @default(RESEND)
  recipientMode            SendRecipientMode       @default(TEST_SIMULATION)
  scenario                 SandboxDeliveryScenario
  idempotencyKey           String                  @unique
  payloadHash              String
  providerPayloadHash      String?
  contentHash              String
  approvedRecipientHash    String
  recipientHash            String
  gateReceipt              Json
  status                   SendAttemptStatus       @default(PREPARED)
  providerMessageId        String?                 @unique
  attemptCount             Int                     @default(0)
  providerCallPerformed    Boolean                 @default(false)
  testMessageSubmitted     Boolean?                @default(false)
  customerMessageSubmitted Boolean                 @default(false)
  requestedBy              String
  preparedAt               DateTime                @default(now())
  expiresAt                DateTime
  dispatchStartedAt        DateTime?
  providerAcceptedAt       DateTime?
  failedAt                 DateTime?
  failureCode              String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  deliveryEvents            DeliveryEvent[] @relation("DeliveryEventMessage")
  deliveryEventsByRecipient DeliveryEvent[] @relation("DeliveryEventRecipient")
  replies                   Reply[]

  @@unique([id, recipientHash])
  @@unique([id, providerMessageId])
  @@index([draftId, status])
  @@index([approvalId])
  @@index([revisionId])
  @@index([contactPointId])
  @@index([permissionId])
  @@index([expiresAt])
}

/// One immutable receipt per signed provider webhook message. The raw payload
/// is verified before parsing and represented only by a SHA-256 hash.
model ProviderWebhookReceipt {
  id                String                @id @default(cuid())
  provider          EmailProvider
  providerEventId   String
  eventType         String
  payloadHash       String
  providerCreatedAt DateTime
  receivedAt        DateTime
  outcome           WebhookReceiptOutcome
  createdAt         DateTime              @default(now())

  deliveryEvent DeliveryEvent?
  reply         Reply?

  @@unique([provider, providerEventId])
  @@index([providerCreatedAt])
  @@index([eventType])
}

/// Append-only normalized delivery result. Provider payloads and recipient
/// addresses are not copied into this table.
model DeliveryEvent {
  id                String                 @id @default(cuid())
  sendAttemptId     String
  sendAttempt       SendAttempt            @relation("DeliveryEventMessage", fields: [sendAttemptId, providerMessageId], references: [id, providerMessageId], map: "DeliveryEvent_attempt_message_fkey")
  recipientAttempt  SendAttempt            @relation("DeliveryEventRecipient", fields: [sendAttemptId, recipientHash], references: [id, recipientHash], map: "DeliveryEvent_attempt_recipient_fkey")
  webhookReceiptId  String                 @unique
  webhookReceipt    ProviderWebhookReceipt @relation(fields: [webhookReceiptId], references: [id])
  type              DeliveryEventType
  providerMessageId String
  recipientHash     String
  receipt           Json
  occurredAt        DateTime
  createdAt         DateTime               @default(now())

  @@index([sendAttemptId, occurredAt])
  @@index([type])
}

/// Minimal inbound receipt. Email addresses, subject and body are hashed; the
/// provider body/attachments are deliberately not retrieved in this phase.
model Reply {
  id               String                 @id @default(cuid())
  sendAttemptId    String?
  sendAttempt      SendAttempt?           @relation(fields: [sendAttemptId], references: [id], onDelete: Restrict, map: "Reply_sendAttemptId_fkey")
  webhookReceiptId String                 @unique
  webhookReceipt   ProviderWebhookReceipt @relation(fields: [webhookReceiptId], references: [id])
  providerEmailId  String
  messageIdHash    String
  senderHash       String
  recipientHash    String
  subjectHash      String
  classification   ReplyClassification    @default(UNCLASSIFIED)
  receipt          Json
  receivedAt       DateTime
  createdAt        DateTime               @default(now())

  @@index([sendAttemptId, receivedAt])
  @@index([receivedAt])
}

/// A sales lead: a Company (and optionally a specific Contact) Growth is
/// actively pursuing. Deliberately simple lifecycle — explainable ranking
/// (Phase 3) will read from this data, not replace it.
model Lead {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id])
  status        LeadStatus     @default(NEW)
  sourceChannel SourceChannel?
  sourceDetail  String?
  notes         String?

  activities    Activity[]
  followUps     FollowUp[]
  opportunities Opportunity[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  evidence  Evidence[]

  @@index([companyId])
  @@index([contactId])
  @@index([status])
}

/// A single logged sales-history event (email drafted/sent, call, note...).
/// Must reference a Lead and/or a Contact — enforced at the application
/// layer (createActivity in apps/api/src/lib/activity.ts) AND in the DB via
/// CHECK constraint "Activity_lead_or_contact_required" (additive migration;
/// Prisma has no native "at least one of" check in the schema language).
model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id])
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id])
  note       String?
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  @@index([leadId])
  @@index([contactId])
  @@index([type])
}

/// A scheduled follow-up task. Queue execution is represented separately by
/// Job; this record remains the business-facing due-date state.
model FollowUp {
  id        String         @id @default(cuid())
  leadId    String?
  lead      Lead?          @relation(fields: [leadId], references: [id])
  contactId String?
  contact   Contact?       @relation(fields: [contactId], references: [id])
  dueAt     DateTime
  status    FollowUpStatus @default(PENDING)
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([dueAt])
  @@index([status])
}

/// A durable, idempotent unit of internal Growth work. `payload` is untrusted
/// input and is never executed as code. Mutable operational state is kept here
/// while the append-only Event table remains the audit log.
model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  payloadHash    String
  idempotencyKey String    @unique
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
}

/// A deterministic, secret-free usage receipt for a model/provider call that
/// actually occurred outside this repository. Recording a receipt never calls
/// a provider; absent a receipt, report cost remains explicitly zero/unknown.
model UsageReceipt {
  id             String   @id @default(cuid())
  provider       String
  model          String
  operation      String
  idempotencyKey String   @unique
  receiptHash    String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMinor      Int      @default(0)
  currency       String   @default("USD")
  occurredAt     DateTime
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([occurredAt])
  @@index([provider, model])
}

/// Idempotent management snapshot for one Europe/Istanbul reporting day.
/// Metrics are deterministic JSON and contain no raw contact values or secrets.
model ManagementReport {
  id          String   @id @default(cuid())
  reportKey   String   @unique
  reportDate  String
  timezone    String   @default("Europe/Istanbul")
  periodStart DateTime
  periodEnd   DateTime
  inputHash   String
  metrics     Json
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reportDate, timezone])
  @@index([periodStart, periodEnd])
}

/// Credential-free social account metadata. `secretManagerRef` is only an
/// opaque future reference; OAuth access/refresh tokens never enter Growth DB.
model SocialConnection {
  id               String                 @id @default(cuid())
  platform         SocialPlatform
  accountKey       String
  accountLabel     String?
  status           SocialConnectionStatus @default(DISCONNECTED)
  secretManagerRef String?
  scopes           Json?
  tokenExpiresAt   DateTime?
  lastValidatedAt  DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([platform, accountKey])
  @@index([platform, status])
}

/// One human-owned source of truth from which platform variants are derived.
/// No provider call or automatic publication is implied by this record.
model MasterContent {
  id         String                     @id @default(cuid())
  title      String
  body       String
  campaignKey String?
  status     SocialMasterContentStatus  @default(DRAFT)
  author     String
  approvedBy String?
  approvedAt DateTime?
  variants   SocialContentVariant[]
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([campaignKey])
}

/// Platform-specific content and the future publish idempotency boundary.
/// `mediaManifest` is metadata only; binaries and provider tokens stay out.
model SocialContentVariant {
  id               String                    @id @default(cuid())
  masterContentId  String
  masterContent    MasterContent             @relation(fields: [masterContentId], references: [id])
  platform         SocialPlatform
  body             String
  mediaManifest    Json?
  contentHash      String
  policyVersion    String
  validationReceipt Json
  status           SocialContentVariantStatus @default(DRAFT)
  author           String
  approvedBy       String?
  approvedAt       DateTime?
  scheduledAt      DateTime?
  publishedAt      DateTime?
  providerPostId   String?
  idempotencyKey   String                    @unique
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([masterContentId, platform])
  @@index([platform, status, scheduledAt])
  @@index([contentHash])
}

/// A Growth sales opportunity. Not a MYLojistik operational record.
model Opportunity {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id])
  stage          OpportunityStage @default(QUALIFICATION)
  estimatedValue Decimal?         @db.Decimal(14, 2)
  currency       String?          @default("TRY")
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([leadId])
  @@index([stage])
}

/// A piece of evidence backing a Company record or an Event (ADR-008).
/// An AI guess is not Evidence — this table only holds sourced facts.
model Evidence {
  id              String                  @id @default(cuid())
  companyId       String?
  company         Company?                @relation(fields: [companyId], references: [id])
  leadId          String?
  lead            Lead?                   @relation(fields: [leadId], references: [id])
  eventId         String?
  event           Event?                  @relation(fields: [eventId], references: [id])
  candidateId     String?
  candidate       ResearchCandidate?      @relation(fields: [candidateId], references: [id])
  sourceUrl       String
  sourceName      String?
  publishedAt     DateTime?
  accessedAt      DateTime                @default(now())
  observedAt      DateTime?
  claimKey        String?
  freshnessStatus EvidenceFreshnessStatus @default(UNKNOWN)
  legalNotes      String?
  summary         String
  /// 0..1 — how much this single piece of evidence should be trusted.
  /// Range is enforced in the DB via CHECK constraint
  /// "Evidence_confidence_range" (additive migration, not expressible here).
  confidence      Float                   @default(0.5)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([leadId])
  @@index([eventId])
  @@index([candidateId])
  @@index([claimKey])
}

/// Immutable audit/event log (ADR-007). Deliberately NOT a full
/// event-sourcing framework — a simple append-only table is enough for now.
/// `entityType`/`entityId` is a lightweight polymorphic reference (not a DB
/// foreign key) so new entity types don't require schema churn.
model Event {
  id         String    @id @default(cuid())
  type       EventType
  entityType String
  entityId   String
  /// Which worker/agent/user produced this event (e.g. "system",
  /// "discovery-worker", a user id). Free text for now.
  actor      String?
  metadata   Json?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  evidences Evidence[]

  @@index([entityType, entityId])
  @@index([type])
  @@index([occurredAt])
}
